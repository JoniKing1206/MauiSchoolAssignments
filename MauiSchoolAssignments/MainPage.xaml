<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MauiSchoolAssignments.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="School Assignments">

    <VerticalStackLayout
        Padding="30"
        Spacing="15"
        VerticalOptions="Center">

        <Label
            Text="School Assignments"
            FontSize="30"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Button
            Text="Assignment 1 - Age Calculator"
            Clicked="AgePageButton_Clicked" />

        <Button
            Text="Assignment 1 - Candles"
            Clicked="CandlesPageButton_Clicked" />

        <Button
            Text="Assignment 2 - User Search"
            Clicked="UserSearchButton_Clicked" />

        <Button
            Text="Dictionary Weapon Search"
            Clicked="WeaponSearchButton_Clicked" />

        <Button
            Text="Slider Candles"
            Clicked="SliderCandlesButton_Clicked" />

        <Button
            Text="Weapon List"
            Clicked="WeaponListButton_Clicked" />
    </VerticalStackLayout>

</ContentPage>