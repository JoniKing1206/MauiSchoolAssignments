<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiSchoolAssignments.Views.AgePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Age Calculator">

    <Grid
        Padding="25"
        RowDefinitions="*,Auto">

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="12">

            <Label
                Text="Age Calculator"
                FontSize="28"
                FontAttributes="Bold" />

            <Entry
                x:Name="NameEntry"
                Placeholder="Enter your name" />

            <Entry
                x:Name="AgeEntry"
                Placeholder="Enter your age"
                Keyboard="Numeric" />

            <Button
                Text="Calculate Age"
                Clicked="CalculateButton_Clicked" />

            <Label
                x:Name="ResultLabel"
                FontSize="20" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>